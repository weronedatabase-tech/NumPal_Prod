# Server port (defaults to 3000)
PORT=3000

# Billing-enabled (paid tier) Gemini API key for server-side expiration date scanning
GEMINI_API_KEY=

# Optional primary model override (defaults to fast, cost-efficient Gemini Flash: gemini-4-hydrogen)
# GEMINI_FLASH_MODEL=gemini-4-hydrogen

# Optional fallback model override on 429/503 (defaults to gemini-3.1-flash-lite)
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
